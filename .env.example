# ─── Public (safe to expose; inlined at build time) ───────────────────────────
# Canonical site URL used for metadata, sitemap, robots, and structured data.
NEXT_PUBLIC_SITE_URL=https://thanatphong.vercel.app

# ─── Server-only (never prefix with NEXT_PUBLIC_) ─────────────────────────────
# GitHub token — optional. Used to raise the GitHub API rate limit when
# fetching repos / activity during builds. Needs `repo` or `public_repo` scope.
GITHUB_TOKEN=

# Notion API key + database ID — optional. When both are set, the blog reads
# posts from Notion; otherwise it falls back to the bundled local posts.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# LTI 1.3 client ID — used to validate the `aud` claim of the blog tool's
# launch token (see lib/blog-data.tsx).
LTI_CLIENT_ID=

# ─── Newsletter (optional) ────────────────────────────────────────────────
# Either point at any service accepting a JSON POST {"email": "..."} —
# Formspree, Buttondown, Zapier, Make, etc. — or use Upstash Redis.
# When neither is set, /api/subscribe returns 501 and the blog sidebar
# shows a "coming soon" message.
NEWSLETTER_WEBHOOK_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Contact form (optional) ─────────────────────────────────────────────
# Webhook receiving JSON POSTs of { name, email, message } — Formspree,
# Zapier, Make, a Slack/Telegram bot, etc. Without it, /api/contact
# returns 501 and the form explains how to reach out directly.
CONTACT_WEBHOOK_URL=
