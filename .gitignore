*.local
notes/
scratch/
*.history

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Agent / local tooling (never commit) ---
.serena/

# --- OS ---
Thumbs.db
Desktop.ini

# --- Logs & temp ---
*.log
*.tmp

# --- Coverage & archives ---
coverage/
.nyc_output/
*.tgz

# --- Next.js diagnostics & cache ---
.next/cache/
.diagnostics/
lighthouse-reports/
.turbo/

# --- Playwright ---
test-results/
playwright-report/
blob-report/
